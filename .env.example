# --- WorkOS Sync Engine ---
# Secret API key (sk_...) for the WorkOS environment to mirror, from API Keys in the WorkOS Dashboard.
WORKOS_API_KEY=

# Not used: the sync pulls the WorkOS Events API on a schedule, with no webhook. The template only checks that it's set.
WORKOS_WEBHOOK_SECRET=placeholder

# Bearer token that GET /status requires, since function URLs are public. For example, the output of `openssl rand -hex 32`.
WORKOS_SYNC_STATUS_TOKEN=

# --- Slack bot ---
# Connection string for the read-only identity_analyst role. The agent runs every query as this role.
ANALYST_DATABASE_URL=

# Optional. Defaults to claude-sonnet-5-5.
# AI_MODEL=claude-sonnet-5-5

# From your Slack app: Basic Information > Signing Secret, and OAuth & Permissions > Bot User OAuth Token (xoxb-).
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
